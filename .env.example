# MySQL on host
DB_URL=jdbc:mysql://host.docker.internal:3306/train_seat?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_real_password
# JWT
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_MS=86400000
# Frontend → backend (browser calls this, so use localhost)
NEXT_PUBLIC_API_URL=http://localhost:8080